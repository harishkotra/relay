{
  "name": "relay",
  "version": "1.0.0",
  "private": true,
  "description": "The same agent twice: a hand-written tool loop next to a Strands Agents TS 1.x agent, compared on identical tasks.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "check": "tsx --env-file-if-exists=.env scripts/check.ts",
    "verify": "tsx --env-file-if-exists=.env scripts/verify.ts",
    "stub": "tsx scripts/stub-provider.ts",
    "loc": "tsx scripts/loc.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@strands-agents/sdk": "^1.20.0",
    "hono": "^4.13.13",
    "openai": "^6.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
