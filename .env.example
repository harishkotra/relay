# Optional. The UI's Settings panel is the primary way to configure a provider;
# these are only fallbacks for runs started from the CLI (npm run verify) or for
# requests that omit a config field. Nothing provider-specific is hardcoded.

# RELAY_BASE_URL=https://api.particle.ai/v1
# RELAY_MODEL=deepseek-v4.1-flash
# RELAY_API_KEY=

# Ports. If :3001 or :5173 is taken, change these instead of killing anything.
# PORT=3001
# HOST=127.0.0.1
# CLIENT_PORT=5173
# VITE_API_TARGET=http://127.0.0.1:3001
